# --- Multi-account mode (recommended) ---
# Comma-separated list of account ids. For each id you set:
#   ALLEGRO_<ID>_LABEL          (human-readable name shown in UI)
#   ALLEGRO_<ID>_ENV            (sandbox | production)
#   ALLEGRO_<ID>_CLIENT_ID      (from apps.developer.allegro.pl)
#   ALLEGRO_<ID>_CLIENT_SECRET
# The first id in the list is the default account.
# Token files are stored as data/tokens.<id>.json.
ALLEGRO_ACCOUNTS=main,shop2,shop3

ALLEGRO_MAIN_LABEL=Main
ALLEGRO_MAIN_ENV=production
ALLEGRO_MAIN_CLIENT_ID=
ALLEGRO_MAIN_CLIENT_SECRET=

ALLEGRO_SHOP2_LABEL=Shop 2
ALLEGRO_SHOP2_ENV=production
ALLEGRO_SHOP2_CLIENT_ID=
ALLEGRO_SHOP2_CLIENT_SECRET=

ALLEGRO_SHOP3_LABEL=Shop 3
ALLEGRO_SHOP3_ENV=production
ALLEGRO_SHOP3_CLIENT_ID=
ALLEGRO_SHOP3_CLIENT_SECRET=

# --- Legacy single-account mode (used only if ALLEGRO_ACCOUNTS is unset) ---
# sandbox | production
ALLEGRO_ENV=sandbox
ALLEGRO_SANDBOX_CLIENT_ID=
ALLEGRO_SANDBOX_CLIENT_SECRET=
ALLEGRO_PROD_CLIENT_ID=
ALLEGRO_PROD_CLIENT_SECRET=

# --- Server ---
PORT=3000
# Public URL of this server, used to build the OAuth redirect URI
# Local dev: http://localhost:3000
# VPS:       https://your-domain.tld
PUBLIC_URL=http://localhost:3000

# Random string used to sign session cookies / OAuth state
SESSION_SECRET=change_me_to_a_long_random_string

# Where token files are stored (mount as a volume in Docker)
DATA_DIR=./data

# --- Allegro environment selector ---
# sandbox | production
ALLEGRO_ENV=sandbox

# --- Sandbox credentials (apps.developer.allegro.pl, "Aplikacja w środowisku Sandbox") ---
ALLEGRO_SANDBOX_CLIENT_ID=
ALLEGRO_SANDBOX_CLIENT_SECRET=

# --- Production credentials ---
ALLEGRO_PROD_CLIENT_ID=
ALLEGRO_PROD_CLIENT_SECRET=

# --- Server ---
PORT=3000
# Public URL of this server, used to build the OAuth redirect URI
# Local dev: http://localhost:3000
# VPS:       https://your-domain.tld
PUBLIC_URL=http://localhost:3000

# Random string used to sign session cookies / OAuth state
SESSION_SECRET=change_me_to_a_long_random_string

# Where token files are stored (mount as a volume in Docker)
DATA_DIR=./data
